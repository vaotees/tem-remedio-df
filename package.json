{
  "name": "tem-remedio-df",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "coletar": "pnpm --filter @tem-remedio/pipeline coletar",
    "lint": "pnpm -r --if-present lint",
    "app": "pnpm --filter @tem-remedio/mobile start",
    "snapshot:app": "cp pipeline/saida/snapshot.json apps/mobile/assets/dados/snapshot-inicial.json"
  }
}
