{
  "expo": {
    "name": "Tem Remédio DF",
    "slug": "tem-remedio-df",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Tem Remédio DF usa sua localização só para mostrar os postos de saúde mais perto de você. Ela não sai do celular."
        }
      ]
    ],
    "scheme": "temremedio",
    "experiments": {
      "typedRoutes": true
    }
  }
}
