{
  "expo": {
    "name": "Tem Remédio DF",
    "slug": "tem-remedio-df",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.vaotees.temremediodf",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.github.vaotees.temremediodf",
      "adaptiveIcon": {
        "backgroundColor": "#0B5FA5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Tem Remédio DF",
      "shortName": "Tem Remédio",
      "lang": "pt-BR",
      "themeColor": "#0B5FA5",
      "backgroundColor": "#F2F5F9",
      "description": "Em qual farmácia de UBS do DF tem o seu remédio hoje. Dados públicos da SES-DF."
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Tem Remédio DF usa sua localização só para mostrar os postos de saúde mais perto de você. Ela não sai do celular."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0F1115"
          }
        }
      ],
      "expo-font"
    ],
    "scheme": "temremedio",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b146d10b-02c2-4538-a1e0-b9d30c6b7a0e"
      }
    },
    "owner": "estevao.marques"
  }
}
